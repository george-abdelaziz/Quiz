@model ICollection<Choice>


<div class="container row">
    <div class="col6">Choices</div>
</div>

<div class="container p-1 m-1">

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Choice</th>
                <th>Is Correct</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var choice in Model)
            {
                <tr>
                    <td>@choice.Text</td>
                    <td>
                        @if(choice.IsCorrect){
                            <p>Correct</p>
                        }
                        else
                        {
                            <p>Wrong</p>
                        }
                    </td>
                    <td>
                        <div class="container" role="group">
                            <a class="btn btn-secondary" asp-controller="Choice" asp-action="Edit" asp-route-id="@choice.Id">
                                Edit <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-danger" asp-controller="Choice" asp-action="Delete" asp-route-id="@choice.Id">
                                Delete <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
