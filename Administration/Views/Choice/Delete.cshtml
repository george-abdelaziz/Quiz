@model Choice


<form method="post">
    <input asp-for="Id" hidden />
    <input asp-for="QuestionId" hidden />
    <div class="form-group">
        <label  asp-for="Text">Choice</label>
        <input disabled asp-for="Text" class="form-control">
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label class="checkbox-label">
            <input disabled type="checkbox" asp-for="IsCorrect" />
            Is Correct?
        </label>
    </div>
    <div class="row p-1">
        <div class="col-6">
            <button type="submit" class="btn btn-danger">Delete</button>
        </div>
        <div class="col-6">
            <a asp-controller="Chioce" asp-action="Index" class="btn btn-secondary">Go Back?</a>
        </div>
    </div>
</form>