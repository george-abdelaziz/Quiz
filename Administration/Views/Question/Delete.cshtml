@model Question


<form method="post">
    <input asp-for="QuizId" hidden />
    <div class="form-group">
        <label asp-for="Text">Question</label>
        <input disabled asp-for="Text" class="form-control">
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input disabled type="checkbox" asp-for="IsMCQ" />
        <label asp-for="IsMCQ" class="checkbox-label"> Is MCQ?</label>
    </div>
    <div class="row p-1">
        <div class="col-6">
            <button type="submit" class="btn btn-danger">Delete</button>
        </div>
        <div class="col-6">
            <a asp-controller="Question" asp-action="Index" class="btn btn-secondary">Go Back?</a>

        </div>
    </div>
</form>
