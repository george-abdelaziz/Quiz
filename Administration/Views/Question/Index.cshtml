@model ICollection<Question>


<div class="container row">
    <div class="col6">Questions</div>
    <div class="col-6">
        @* <a class="btn btn-primary" asp-controller="Question" asp-action="Create" >
            Create Question <i class="bi bi-plus-circle"></i>
        </a> *@
    </div>
</div>

<div class="container p-1 m-1">

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Question</th>
                <th>Answer Type</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var question in Model)
            {
                <tr>
                    <td>@question.Id</td>
                    <td>@question.Text</td>
                    <td>
                        @if(question.IsMCQ){
                            <p>Multiple Choice</p>
                        }
                        else
                        {
                            <p>Text</p>
                        }
                    </td>
                    <td>

                        <div class="container" role="group">
                            <a class="btn btn-primary" asp-controller="Choice" asp-action="Create" asp-route-id="@question.Id">
                                Add Choice <i class="bi bi-plus-circle"></i></a>
                            <a class="btn btn-secondary" asp-controller="Question" asp-action="Edit" asp-route-id="@question.Id">
                                Edit <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-danger" asp-controller="Question" asp-action="Delete" asp-route-id="@question.Id">
                                Delete <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
