@model TakeQuizDto


<div class="container mt-4">
    <div class="card">
        <img class="card-img-top" src='@Url.Action("GetImage", "Home", new { id = Model.Id })' alt="Quiz Image">
        <div class="card-body">
            <h1 class="card-title">@Model.Name</h1>
            <p class="card-text">@Model.Description</p>
        </div>
        <div class="card-footer text-muted text-right">
            <small>@Model.Date</small>
        </div>
    </div>
</div>
<form method="post">
    <div class="" hidden>
        <input asp-for="Id" hidden />
        <input asp-for="Name" hidden />
        <input asp-for="Description" hidden />
        <input asp-for="Date" hidden />
        <input asp-for="ImageName" hidden />
        <input asp-for="ImageType" hidden />
    </div>
    <div class="container mt-4">
        <label asp-for="@Model.Email">Email</label>
        <input asp-for="@Model.Email" class=" form-control">
        <span asp-validation-for="@Model.Email" class="text-danger"></span>
        <ol>

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                <div>
                    <input asp-for="Questions[@i].Id" type="hidden" />
                    <input asp-for="Questions[@i].Text" type="hidden" />
                    <input asp-for="Questions[@i].IsMCQ" type="hidden" />
                    <input asp-for="Answers[@i].QuestionId" value="@Model.Questions[i].Id" type="hidden" />
                </div>
                <li>
                    <div class="mb-4">
                        <h4>@Model.Questions[i].Text</h4>
                        @if (Model.Questions[i].IsMCQ && Model.Questions[i].Choices.Count > 0)
                        {
                            <div>
                                @for (int j = 0; j < Model.Questions[i].Choices.Count; j++)
                                {
                                    <input asp-for="Questions[i].Choices[j].Id" type="hidden" />
                                    <input asp-for="Questions[i].Choices[j].Text" type="hidden" />
                                    <input asp-for="Questions[i].Choices[j].IsCorrect" type="hidden" />
                                }
                            </div>

                            <select asp-for="@Model.Answers[@i].QuestionAnswer" asp-items="@Model.Questions[i].Choices.ToSelectListItems()" class="form-select">
                                <option disabled selected>-Select Choice-</option>
                            </select>
                        }
                        else
                        {
                            <div class="form-group">
                                <label>Anwser Question</label>
                                <input asp-for="@Model.Answers[@i].QuestionAnswer" class="form-control">
                            </div>
                        }
                    </div>
                </li>
            }
    </ol>
        <div class="row p-1">
            <div class="col-6">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
            <div class="col-6">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Go Back?</a>
            </div>
        </div>
    </div>

</form>